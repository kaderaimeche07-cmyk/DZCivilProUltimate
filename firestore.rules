rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Zero-Trust Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidVisitorCountValue(val) {
      return val is int && val >= 1 && val <= 1000000000;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && data.updatedAt is timestamp;
    }

    // 3. Unique Visitors Counter (Write-only +1 on count field, no public reads or deletes)
    match /app_stats/visitors {
      allow read, delete: if false;
      allow create: if incoming().keys().hasAll(['count'])
        && incoming().keys().hasOnly(['count'])
        && isValidVisitorCountValue(incoming().count)
        && incoming().count == 1;
      allow update: if incoming().diff(existing()).affectedKeys().hasOnly(['count'])
        && isValidVisitorCountValue(incoming().count)
        && existing().count is int
        && incoming().count == existing().count + 1;
    }

    // 4. Owner-Scoped User Profile Documents (No collection listing, strict UID ownership)
    match /users/{userId} {
      allow get: if isValidId(userId)
        && isSignedIn()
        && request.auth.uid == userId;
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);
      allow delete: if isValidId(userId)
        && isSignedIn()
        && request.auth.uid == userId;
    }
  }
}
